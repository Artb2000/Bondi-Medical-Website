---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteCopy } from '../content/siteCopy';

const copy = siteCopy.home;
---

<BaseLayout
	title={copy.title}
	description={copy.description}
>
	<Fragment slot="hero">
		<section class="shell top-announcement" aria-label="Clinic billing notice">
			<p>
				<svg class="announcement-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<rect x="3" y="6" width="18" height="12" rx="2"></rect>
					<line x1="3" y1="10" x2="21" y2="10"></line>
					<line x1="7" y1="15" x2="11" y2="15"></line>
				</svg>
				<span><a href="/fees#bulk-billing">Bulk Billing available*</a></span>
			</p>
			<p>
				<svg class="announcement-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path d="M5 12a7 7 0 0 1 14 0"></path>
					<rect x="3" y="11.5" width="3.5" height="5.5" rx="1.2"></rect>
					<rect x="17.5" y="11.5" width="3.5" height="5.5" rx="1.2"></rect>
					<path d="M7 18h5.5a2.5 2.5 0 0 0 2.5-2.5"></path>
					<circle cx="15.5" cy="15.5" r="0.9" fill="currentColor" stroke="none"></circle>
				</svg>
				<span>Telehealth available</span>
			</p>
			<p>
				<svg class="announcement-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<circle cx="9.5" cy="5" r="1.7"></circle>
					<path d="M8.5 8.5l3 2.2"></path>
					<path d="M11.5 10.7l2.4-1.4"></path>
					<path d="M10 10.2l-1.8 3.4"></path>
					<path d="M11.3 10.8l2.2 3.1"></path>
					<path d="M8.2 13.6l-2.2 4.2"></path>
					<path d="M13.5 13.9l3.1 3.6"></path>
				</svg>
				<span>Walk-In's accepted</span>
			</p>
		</section>

		<section class="hero shell">
			<div>
				<p class="kicker">{copy.hero.eyebrow}</p>
				<h1>{copy.hero.heading}</h1>
				<p>
					{copy.hero.intro}
				</p>
			</div>
			<img src="/images/reception.jpg" alt="Bondi Medical reception area" loading="eager" />
		</section>
	</Fragment>

	<Fragment slot="intro">
		<section class="shell section-block">
			<h2 class="pane-heading">{copy.intro.title}</h2>
			<p>
				{copy.intro.body}
			</p>
		</section>
	</Fragment>

	<Fragment slot="contentSections">
		<section class="shell section-block">
			<div class="section-head">
				<h2>{copy.featuredServices.title}</h2>
				<a href="/services">See all services</a>
			</div>
			<div class="card-grid services-grid">
				<article class="service-card">
					<h3>{copy.featuredServices.cards[0].title}</h3>
					<p>
						{copy.featuredServices.cards[0].body}
					</p>
				</article>
				<article class="service-card">
					<h3>{copy.featuredServices.cards[1].title}</h3>
					<p>
						{copy.featuredServices.cards[1].body}
					</p>
				</article>
				<article class="service-card">
					<h3>{copy.featuredServices.cards[2].title}</h3>
					<p>
						{copy.featuredServices.cards[2].body}
					</p>
				</article>
			</div>
		</section>

		<section class="shell section-block">
			<h2 class="pane-heading">{copy.locationTeaser.title}</h2>
			<p>
				{copy.locationTeaser.body}
			</p>
			<p>
				{copy.locationTeaser.support}
			</p>
		</section>
	</Fragment>

	<Fragment slot="seo">
		<meta name="robots" content="index,follow" />
	</Fragment>
</BaseLayout>
